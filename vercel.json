{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "installCommand": "cd frontend/vue-app && npm install",
  "buildCommand": "cd frontend/vue-app && npm run build",
  "outputDirectory": "frontend/vue-app/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
